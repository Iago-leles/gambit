{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gambit-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Domínio próprio. No deploy, a Cloudflare cria o registro DNS e o certificado.
  // Se este nome mudar, atualize também ALLOWED_ORIGINS em apps/server/wrangler.jsonc
  // e as URLs de .github/workflows/deploy.yml.
  "routes": [{ "pattern": "gambit.iagoleles.com", "custom_domain": true }],
  // Com "routes", o Wrangler desliga o workers.dev sozinho. Aqui ele fica ligado de propósito,
  // para o endereço antigo continuar funcionando.
  "workers_dev": true,
  "observability": { "enabled": true },
}
