{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gambit-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Domínio próprio. No deploy, a Cloudflare cria o registro DNS e o certificado.
  // O endereço do workers.dev continua ligado. Se este nome mudar, atualize também
  // ALLOWED_ORIGINS em apps/server/wrangler.jsonc e as URLs de .github/workflows/deploy.yml.
  "routes": [{ "pattern": "gambit.iagoleles.com", "custom_domain": true }],
  "observability": { "enabled": true },
}
