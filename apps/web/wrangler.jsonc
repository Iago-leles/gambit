{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gambit-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Domínio próprio. No deploy, a Cloudflare cria o registro DNS e o certificado.
  // Se este nome mudar, atualize também ALLOWED_ORIGINS em apps/server/wrangler.jsonc
  // e as URLs de .github/workflows/deploy.yml.
  "routes": [{ "pattern": "gambit.iagoleles.com", "custom_domain": true }],
  // O site responde só no domínio próprio. O endereço do workers.dev e os endereços de
  // pré-visualização ficam desligados, explicitamente. O Wrangler não muda uma configuração
  // de preview que já existe, então "preview_urls" precisa estar escrito aqui.
  // Para religar o workers.dev: workers_dev true, e inclua a origem em ALLOWED_ORIGINS.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
