{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gambit-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }],
  },
  // Durable Objects com SQLite: disponíveis no plano Free (ADR 010).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  "vars": {
    // Sites que podem falar com o servidor (CORS e WebSocket), separados por vírgula.
    // Origens locais (localhost) só valem quando o próprio servidor roda local.
    "ALLOWED_ORIGINS": "https://gambit.iagoleles.com",
  },
}
